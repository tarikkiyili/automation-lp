PORT=3000
HOST=127.0.0.1
DATABASE_DRIVER=mongodb
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=randevu
# Optional isolated Atlas tests; never use the application database for tests.
MONGODB_TEST_DB_NAME=randevu_test
MONGODB_E2E_DB_NAME=randevu_e2e_test
# Offline tests use DATABASE_DRIVER=sqlite and DATABASE_PATH=./data/e2e.sqlite.
# Set this to the exact public origin in production (no trailing slash).
# PUBLIC_ORIGIN=https://your-domain.example
# Only set to the known number of reverse proxies in front of this server.
TRUST_PROXY_HOPS=0
REQUESTS_PER_MINUTE=10
